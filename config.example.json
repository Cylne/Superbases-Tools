{
  "source": {"name": "supabase-source", "database_url": "${SOURCE_DATABASE_URL}", "project_url": "${SOURCE_PROJECT_URL}", "service_role_key": "${SOURCE_SERVICE_ROLE_KEY}", "project_ref": "${SOURCE_PROJECT_REF:-}", "access_token": "${SUPABASE_ACCESS_TOKEN:-}"},
  "target": {"name": "supabase-target", "database_url": "${TARGET_DATABASE_URL}", "project_url": "${TARGET_PROJECT_URL}", "service_role_key": "${TARGET_SERVICE_ROLE_KEY}", "project_ref": "${TARGET_PROJECT_REF:-}", "access_token": "${SUPABASE_ACCESS_TOKEN:-}"},
